<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IrisNeuralNet\IrisNeuralNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Все датасеты рядом с exe: раньше копировался только iris.csv, и Sonar из VS «не находил файл». -->
    <None Update="iris.csv;sonar.csv;boston.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
